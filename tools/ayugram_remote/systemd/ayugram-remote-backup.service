[Unit]
Description=Encrypted offhost AyuGram profile backup
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/ayugram-remote/backup.env

[Service]
Type=oneshot
Slice=ayugram-remote.slice
OOMScoreAdjust=1000
EnvironmentFile=/etc/ayugram-remote/backup.env
Environment=GOGC=20 GOMAXPROCS=1
ExecStart=/opt/ayugram-remote/backup.sh
ExecStopPost=-/usr/bin/systemctl thaw ayugram-remote-client.service
ExecStopPost=/usr/bin/rm -rf /var/lib/ayugram-remote/backup-staging/profile
TimeoutStartSec=15min
TimeoutStopSec=20
KillMode=control-group
UMask=0077
StandardOutput=null
StandardError=null
