@@ -0,0 +1,152 @@
+#include "ayu/data/deleted_message_restore.h"
+
+#include <sqlite3.h>
+#include <algorithm>
+#include <cassert>
+#include <iostream>
+#include <filesystem>
+#include <string>
+#include <vector>
+
+namespace {
+
+struct Row {
+	long long userId = 1;
+	long long dialogId = 2;
+	long long topicId = 0;
+	long long replyTopId = 0;
+	bool replyForumTopic = false;
+	int date = 100;
+	int flags = 0;
+	int messageId = 50;
+	std::string text = "saved text";
+};
+
+void CheckPolicy() {
+	using namespace AyuMessages;
+	const auto partial = DeletedRange(20, 80, false, false, 1000);
+	assert(partial.contains(20) && partial.contains(80));
+	assert(!partial.contains(19) && !partial.contains(81));
+	assert(!DeletedRange(0, 0, false, true, 1000).contains(50));
+	assert(!DeletedRange(0, 0, true, false, 1000).contains(50));
+	const auto empty = DeletedRange(0, 0, true, true, 1000);
+	assert(empty.contains(1) && empty.contains(1000));
+	assert(!empty.contains(0) && !empty.contains(1001));
+	assert(DeletedRange(20, 80, true, false, 1000).contains(1));
+	assert(!DeletedRange(20, 80, true, false, 1000).contains(81));
+	assert(DeletedRange(20, 80, false, true, 1000).contains(1000));
+	assert(!DeletedRange(20, 80, false, true, 1000).contains(19));
+
+	using Sender = DeletedSenderIdentity;
+	assert(DeletedSender(11, 1, 2, 0, false, false) == Sender::Unknown);
+	assert(DeletedSender(2, 1, 2, 0, false, false) == Sender::Unknown);
+	assert(DeletedSender(2, 1, 2, 0, true, false) == Sender::Peer);
+	assert(DeletedSender(1, 1, 2, 2, false, false) == Sender::Self);
+	assert(DeletedSender(11, 1, 2, 2, false, false) == Sender::Unknown);
+	assert(DeletedSender(2, 1, 2, 2, true, false) == Sender::Unknown);
+	assert(DeletedSender(2, 1, 2, 0x4002, false, true) == Sender::Peer);
+	assert(DeletedSender(2, 1, 2, 0x4000, false, true) == Sender::Peer);
+	assert(DeletedSender(11, 1, 2, 0x4000, false, true) == Sender::Unknown);
+	assert(DeletedSender(2, 1, 2, 0x4000, false, false) == Sender::Invalid);
+
+	auto row = Row();
+	assert(CanRestoreDeleted(row, 1, 2, partial));
+	assert(!CanRestoreDeleted(row, 3, 2, partial));
+	assert(!CanRestoreDeleted(row, 1, 3, partial));
+	row.topicId = 7;
+	assert(!CanRestoreDeleted(row, 1, 2, partial));
+	row.topicId = 0;
+	row.replyTopId = 9;
+	assert(!CanRestoreDeleted(row, 1, 2, partial));
+	row.replyTopId = 0;
+	row.replyForumTopic = true;
+	assert(!CanRestoreDeleted(row, 1, 2, partial));
+	row.replyForumTopic = false;
+	row.flags = 0x00040000;
+	assert(!CanRestoreDeleted(row, 1, 2, partial));
+	row.flags = 0x10000000;
+	assert(!CanRestoreDeleted(row, 1, 2, partial));
+	row.flags = 0;
+	row.messageId = -1;
+	assert(!CanRestoreDeleted(row, 1, 2, partial));
+	row.messageId = 50;
+	row.date = 0;
+	assert(!CanRestoreDeleted(row, 1, 2, partial));
+	row.date = 100;
+	row.text.clear();
+	assert(!CanRestoreDeleted(row, 1, 2, partial));
+}
+
+void CheckDatabasePaging(const char *path) {
+	sqlite3 *db = nullptr;
+	assert(sqlite3_open(path, &db) == SQLITE_OK);
+	assert(sqlite3_exec(db,
+		"CREATE TABLE IF NOT EXISTS deleted (user INTEGER, dialog INTEGER, "
+		"topic INTEGER, id INTEGER, date INTEGER, text TEXT)",
+		nullptr, nullptr, nullptr) == SQLITE_OK);
+	assert(sqlite3_exec(db, "DELETE FROM deleted", nullptr, nullptr, nullptr)
+		== SQLITE_OK);
+	assert(sqlite3_exec(db, "BEGIN", nullptr, nullptr, nullptr) == SQLITE_OK);
+	for (auto id = 1; id <= 701; ++id) {
+		const auto sql = "INSERT INTO deleted VALUES (1,2,0,"
+			+ std::to_string(id) + ",100,'saved text')";
+		assert(sqlite3_exec(db, sql.c_str(), nullptr, nullptr, nullptr)
+			== SQLITE_OK);
+	}
+	assert(sqlite3_exec(db,
+		"INSERT INTO deleted VALUES (99,2,0,400,100,'other account');"
+		"INSERT INTO deleted VALUES (1,99,0,401,100,'other chat');"
+		"INSERT INTO deleted VALUES (1,2,9,402,100,'topic');"
+		"COMMIT", nullptr, nullptr, nullptr) == SQLITE_OK);
+	assert(sqlite3_close(db) == SQLITE_OK);
+	// Reopen the actual SQLite file to check persistence across connections.
+	assert(sqlite3_open(path, &db) == SQLITE_OK);
+	const auto range = AyuMessages::DeletedRange(100, 600, false, false, 1000);
+	auto before = range.before;
+	auto ids = std::vector<int>();
+	while (before > range.after) {
+		sqlite3_stmt *statement = nullptr;
+		assert(sqlite3_prepare_v2(db,
+			"SELECT user,dialog,topic,id,date,text FROM deleted "
+			"WHERE user=1 AND dialog=2 AND id>? AND id<? "
+			"ORDER BY id DESC LIMIT 32", -1, &statement, nullptr) == SQLITE_OK);
+		sqlite3_bind_int64(statement, 1, range.after);
+		sqlite3_bind_int64(statement, 2, before);
+		auto next = before;
+		while (sqlite3_step(statement) == SQLITE_ROW) {
+			auto row = Row();
+			row.userId = sqlite3_column_int64(statement, 0);
+			row.dialogId = sqlite3_column_int64(statement, 1);
+			row.topicId = sqlite3_column_int64(statement, 2);
+			row.messageId = sqlite3_column_int(statement, 3);
+			row.date = sqlite3_column_int(statement, 4);
+			next = row.messageId;
+			if (AyuMessages::CanRestoreDeleted(row, 1, 2, range)) {
+				ids.push_back(row.messageId);
+			}
+		}
+		sqlite3_finalize(statement);
+		if (next >= before) {
+			break;
+		}
+		before = next;
+	}
+	assert(ids.size() == 501);
+	assert(ids.front() == 600 && ids.back() == 100);
+	assert(std::count(ids.begin(), ids.end(), 402) == 1);
+	assert(std::is_sorted(ids.begin(), ids.end(), std::greater<>()));
+	assert(sqlite3_close(db) == SQLITE_OK);
+}
+
+} // namespace
+
+int main(int argc, char **argv) {
+	if (argc != 2 || !*argv[1] || std::filesystem::exists(
+			std::filesystem::symlink_status(argv[1]))) {
+		std::cerr << "Pass a fresh, nonexistent test database path.\n";
+		return 1;
+	}
+	CheckPolicy();
+	CheckDatabasePaging(argv[1]);
+	std::cout << "PASS: bounds, isolation, unsupported topics, persistence, paging\n";
+}
