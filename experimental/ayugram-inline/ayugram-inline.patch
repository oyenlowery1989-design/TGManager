+
+void History::restoreDeletedMessages() {
+	cancelDeletedMessageRestore();
+	if (!AyuSettings::getInstance().saveDeletedMessages()
+		|| peer->isSelf()
+		|| peer->isForum()
+		|| peer->isMonoforum()) {
+		return;
+	}
+
+	const auto range = AyuMessages::DeletedRange(
+		minMsgId().bare,
+		maxMsgId().bare,
+		loadedAtTop(),
+		loadedAtBottom(),
+		ServerMaxMsgId.bare);
+	if (range.before <= range.after) {
+		return;
+	}
+	_deletedRestoreAfter = range.after;
+	_deletedRestoreBefore = _deletedRestoreCursor = range.before;
+	queueDeletedMessagesPage();
+}
+
+void History::queueDeletedMessagesPage() {
+	const auto weak = base::make_weak(this);
+	const auto generation = _deletedRestoreGeneration;
+	const auto range = AyuMessages::DeletedHistoryRange{
+		.after = _deletedRestoreAfter,
+		.before = _deletedRestoreBefore,
+	};
+	const auto before = _deletedRestoreCursor;
+	const auto user = session().userId().bare & PeerId::kChatTypeMask;
+	const auto dialog = getDialogIdFromPeer(peer);
+	constexpr auto kPageSize = 32;
+	crl::async([=] {
+		auto rows = AyuDatabase::getDeletedMessages(
+			user, dialog, 0, range.after, before, kPageSize);
+		crl::on_main([=, rows = std::move(rows)] {
+			if (!weak || generation != _deletedRestoreGeneration) {
+				return;
+			}
+			const auto current = AyuMessages::DeletedRange(
+				minMsgId().bare,
+				maxMsgId().bare,
+				loadedAtTop(),
+				loadedAtBottom(),
+				ServerMaxMsgId.bare);
+			if (!AyuSettings::getInstance().saveDeletedMessages()
+				|| peer->isSelf()
+				|| peer->isForum()
+				|| peer->isMonoforum()
+				|| current.after != range.after
+				|| current.before != range.before) {
+				restoreDeletedMessages();
+				return;
+			}
+			if (rows.empty()) {
+				return;
+			}
+			for (const auto &row : rows) {
+				if (!AyuMessages::CanRestoreDeleted(row, user, dialog, range)) {
+					continue;
+				}
+				auto item = owner().message(peer->id, MsgId(row.messageId));
+				if (item && (!item->isDeleted() || item->mainView())) {
+					continue;
+				}
+				if (!item) {
+					const auto outgoing = (row.flags & 0x00000002) != 0;
+					const auto post = (row.flags & 0x00004000) != 0;
+					const auto identity = AyuMessages::DeletedSender(
+						row.fromId,
+						user,
+						peer->id.value & PeerId::kChatTypeMask,
+						row.flags,
+						peer->isUser(),
+						peer->isChannel());
+					if (identity == AyuMessages::DeletedSenderIdentity::Invalid) {
+						continue;
+					}
+					PeerData *sender = nullptr;
+					if (identity == AyuMessages::DeletedSenderIdentity::Self) {
+						sender = owner().peerLoaded(peerFromUser(session().userId()));
+					} else if (identity == AyuMessages::DeletedSenderIdentity::Peer) {
+						sender = peer;
+					}
+					// Old rows lack sender type; render others with a neutral identity.
+					auto flags = sender
+						? MessageFlags(MessageFlag::HasFromId)
+						: MessageFlags();
+					if (outgoing) {
+						flags |= MessageFlag::Outgoing;
+					}
+					if (post) {
+						flags |= MessageFlag::Post;
+					}
+					auto text = TextWithEntities{ QString::fromStdString(row.text) };
+					if (!row.textEntities.empty()) {
+						const auto entities = AyuMapper::deserializeTextWithEntities(
+							row.textEntities);
+						text.entities = Api::EntitiesFromMTP(&session(), entities.v);
+					}
+					item = makeMessage({
+						.id = MsgId(row.messageId),
+						.flags = flags,
+						.from = sender ? sender->id : PeerId(0),
+						.date = row.date,
+					}, text, MTP_messageMediaEmpty());
+					item->setRestoredDeleted(!sender);
+				}
+
+				auto inserted = false;
+				for (auto blockIndex = 0; blockIndex != blocks.size(); ++blockIndex) {
+					const auto &messages = blocks[blockIndex]->messages;
+					for (auto index = 0; index != messages.size(); ++index) {
+						const auto next = messages[index]->data();
+						if (next->isRegular() && next->id > item->id) {
+							addNewInTheMiddle(item, blockIndex, index);
+							inserted = true;
+							break;
+						}
+					}
+					if (inserted) {
+						break;
+					}
+				}
+				if (!inserted) {
+					addItemToBlock(item);
+				}
+			}
+			owner().notifyHistoryChangeDelayed(this);
+			const auto next = ID(rows.back().messageId);
+			if (rows.size() == kPageSize
+				&& next > range.after
+				&& next < before) {
+				_deletedRestoreCursor = next;
+				queueDeletedMessagesPage();
+			}
+			owner().sendHistoryChangeNotifications();
+		});
+	});
 }
 
