@@ -0,0 +1,90 @@
+#include "ayu/data/local_read_state.h"
+
+#include <cassert>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <iterator>
+#include <map>
+#include <vector>
+
+using namespace Ayu::LocalRead;
+
+void CheckPolicy() {
+	const auto record = Record{ 501, 1792065600, 0 };
+	assert(Parse(Serialize(record)) == record);
+	assert(Parse(Serialize({ 0, 0, 1 })).unreadMark == 1);
+	for (const auto bad : { "", "2:501:1:0", "1:-1:1:0", "1:2:-1:0",
+		"1:2147483648:1:0", "1:2:1:3", "1:2:1:0x", "1:2:1:",
+		"1:9999999999999999999999999999:1:0", "1:2:1:0:0" }) {
+		assert(Parse(bad) == Record());
+	}
+	assert(Key(1, 2) != Key(2, 2));
+	assert(Key(1, 2) != Key(1, (1ULL << 32) + 2));
+	assert(Merge(501, 400, 501, 40).count == 0);
+	assert(SnapshotIsStale(501, 502));
+	assert(!SnapshotIsStale(502, 502));
+	assert(!SnapshotIsStale(502, 501));
+	assert(Merge(501, 510, 600, 7).count == 7);
+	assert(Merge(501, 510, 600, 7).till == 510);
+	assert(!Merge(501, 400, 600, 40).count);
+	assert(!Merge(501, 400, -1, 40).count);
+	assert(Merge(501, 400, 600, 0).count == 0);
+	assert(Merge(501, 400, 0, 0).till == 501);
+
+	auto counter = Counter{ .till = 501, .before = 601 };
+	const auto page1 = std::vector<Message>{ {600, false}, {590, true}, {540, true} };
+	const auto page2 = std::vector<Message>{ {520, false}, {510, true} };
+	assert(counter.add(page1) && !counter.complete && counter.count == 2);
+	assert(counter.add(page2) && !counter.complete && counter.count == 3);
+	assert(counter.add({}) && counter.complete && counter.count == 3);
+	// Deleted messages and ID gaps are absent, not subtracted as if still present.
+	auto deleted = Counter{ .till = 501, .before = 601 };
+	assert(deleted.add(std::vector<Message>{ {600, false}, {510, true} }));
+	assert(deleted.add({}) && deleted.count == 1);
+	// Empty/error/duplicate or non-progressing responses never become a zero count.
+	for (const auto &page : {
+		std::vector<Message>{{600, true, false}},
+		std::vector<Message>{{600, true}, {600, true}},
+		std::vector<Message>{{601, true}},
+		std::vector<Message>{{0, true}},
+	}) {
+		auto failed = Counter{ .till = 501, .before = 601 };
+		assert(!failed.add(page) && failed.failed && !failed.complete);
+	}
+	auto bounded = Counter{ .till = 1, .before = 10000 };
+	for (auto i = 0; i < 20; ++i) {
+		assert(bounded.add(std::vector<Message>{{9999 - i, true}}));
+	}
+	assert(!bounded.add({}) && bounded.failed && !bounded.complete);
+	// Partial reads retain only the newer incoming messages.
+	auto partial = Counter{ .till = 550, .before = 601 };
+	assert(partial.add(page1) && partial.complete && partial.count == 1);
+}
+
+int main(int argc, char **argv) {
+	CheckPolicy();
+	if (argc != 3) {
+		return 1;
+	}
+	const auto path = std::filesystem::path(argv[2]);
+	const auto record = Record{ 501, 1792065600, 0 };
+	if (std::string_view(argv[1]) == "write") {
+		assert(!std::filesystem::exists(std::filesystem::symlink_status(path)));
+		auto output = std::ofstream(path, std::ios::binary);
+		output << Serialize(record);
+		output.close();
+		assert(output.good());
+	} else {
+		assert(std::string_view(argv[1]) == "read");
+		assert(std::filesystem::is_regular_file(std::filesystem::symlink_status(path)));
+		auto input = std::ifstream(path, std::ios::binary);
+		const auto bytes = std::string(std::istreambuf_iterator<char>(input), {});
+		const auto restored = Parse(bytes);
+		assert(restored == record);
+		assert(Merge(restored.till, 400, 501, 40).count == 0);
+		assert(!Merge(restored.till, 400, 600, 43).count);
+	}
+	std::cout << "PASS: restart, read timestamp, account/peer isolation, partial reads, "
+		"new/deleted/outgoing messages, malformed data, bounded paging\n";
+}
