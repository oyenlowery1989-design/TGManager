+// Local restoration policy; independent of UI and database dependencies.
+#pragma once
+
+#include <cstdint>
+
+namespace AyuMessages {
+
+struct DeletedHistoryRange {
+	std::int64_t after = 0;
+	std::int64_t before = 0;
+
+	[[nodiscard]] bool contains(std::int64_t id) const {
+		return id > after && id < before;
+	}
+};
+
+[[nodiscard]] inline DeletedHistoryRange DeletedRange(
+		std::int64_t first,
+		std::int64_t last,
+		bool atTop,
+		bool atBottom,
+		std::int64_t serverMax) {
+	if ((!first || !last) && !(atTop && atBottom)) {
+		return {};
+	}
+	return {
+		.after = atTop ? 0 : first - 1,
+		.before = atBottom ? serverMax + 1 : last + 1,
+	};
+}
+
+enum class DeletedSenderIdentity {
+	Invalid,
+	Unknown,
+	Self,
+	Peer,
+};
+
+[[nodiscard]] inline DeletedSenderIdentity DeletedSender(
+		std::int64_t from,
+		std::int64_t self,
+		std::int64_t peer,
+		int flags,
+		bool privateChat,
+		bool channel) {
+	const auto outgoing = (flags & 0x00000002) != 0;
+	const auto post = (flags & 0x00004000) != 0;
+	if (post && !channel) {
+		return DeletedSenderIdentity::Invalid;
+	} else if (outgoing && from == self) {
+		return DeletedSenderIdentity::Self;
+	} else if ((!outgoing || post) && (privateChat || post) && from == peer) {
+		return DeletedSenderIdentity::Peer;
+	}
+	return DeletedSenderIdentity::Unknown;
+}
+
+template <typename Message>
+[[nodiscard]] bool CanRestoreDeleted(
+		const Message &message,
+		std::int64_t user,
+		std::int64_t dialog,
+		DeletedHistoryRange range) {
+	return message.userId == user
+		&& message.dialogId == dialog
+		&& message.topicId == 0
+		&& message.replyTopId == 0
+		&& !message.replyForumTopic
+		&& !(message.flags & (0x00040000 | 0x10000000))
+		&& message.date > 0
+		&& !message.text.empty()
+		&& range.contains(message.messageId);
+}
+
+} // namespace AyuMessages
