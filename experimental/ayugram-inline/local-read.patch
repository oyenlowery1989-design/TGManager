+#pragma once
+
+#include <algorithm>
+#include <charconv>
+#include <cstdint>
+#include <limits>
+#include <optional>
+#include <span>
+#include <string>
+#include <string_view>
+
+namespace Ayu::LocalRead {
+
+struct Record {
+	std::int64_t till = 0;
+	std::int64_t readAt = 0;
+	int unreadMark = -1;
+	friend bool operator==(const Record &, const Record &) = default;
+};
+
+inline std::string Key(std::uint64_t user, std::uint64_t peer) {
+	return "ayu/local-read/1/" + std::to_string(user)
+		+ "/" + std::to_string(peer);
+}
+
+inline std::string Serialize(Record record) {
+	return "1:" + std::to_string(record.till)
+		+ ":" + std::to_string(record.readAt)
+		+ ":" + std::to_string(record.unreadMark);
+}
+
+inline Record Parse(std::string_view bytes) {
+	if (!bytes.starts_with("1:") || bytes.size() > 64) {
+		return {};
+	}
+	bytes.remove_prefix(2);
+	auto record = Record();
+	const auto number = [&](auto &value, bool last) {
+		const auto end = last ? bytes.size() : bytes.find(':');
+		if (!end || end == std::string_view::npos) {
+			return false;
+		}
+		const auto result = std::from_chars(
+			bytes.data(), bytes.data() + end, value);
+		if (result.ec != std::errc() || result.ptr != bytes.data() + end) {
+			return false;
+		}
+		bytes.remove_prefix(end + (last ? 0 : 1));
+		return true;
+	};
+	if (!number(record.till, false)
+		|| !number(record.readAt, false)
+		|| !number(record.unreadMark, true)
+		|| record.till < 0
+		|| record.till > std::numeric_limits<std::int32_t>::max()
+		|| record.readAt < 0
+		|| record.unreadMark < -1
+		|| record.unreadMark > 1) {
+		return {};
+	}
+	return record;
+}
+
+inline bool SnapshotIsStale(std::int64_t top, std::int64_t knownTop) {
+	return knownTop > top;
+}
+
+struct MergeResult {
+	std::int64_t till = 0;
+	std::optional<int> count;
+};
+
+inline MergeResult Merge(
+		std::int64_t local,
+		std::int64_t server,
+		std::int64_t top,
+		int serverCount) {
+	return {
+		.till = std::max(local, server),
+		.count = (server >= local || !serverCount)
+			? std::optional<int>(serverCount)
+			: (top >= 0 && top <= local)
+			? std::optional<int>(0) : std::nullopt,
+	};
+}
+
+struct Message {
+	std::int64_t id = 0;
+	bool incoming = false;
+	bool known = true;
+};
+
+struct Counter {
+	std::int64_t till = 0;
+	std::int64_t before = 0;
+	int count = 0;
+	int pages = 0;
+	bool complete = false;
+	bool failed = false;
+
+	bool add(std::span<const Message> messages) {
+		if (complete || failed || ++pages > 20) {
+			failed = true;
+			return false;
+		}
+		if (messages.empty()) {
+			complete = true;
+			return true;
+		}
+		auto next = before;
+		for (const auto &message : messages) {
+			if (message.id <= 0 || message.id >= next || !message.known) {
+				failed = true;
+				return false;
+			}
+			next = message.id;
+			if (message.id <= till) {
+				complete = true;
+			} else if (message.incoming) {
+				++count;
+			}
+		}
+		before = next;
+		return true;
+	}
+};
+
