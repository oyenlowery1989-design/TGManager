+bool History::supportsLocalRead() const {
+	return !peer->isSelf() && !peer->isForum() && !peer->isMonoforum();
+}
+
+void History::loadLocalRead() {
+	if (!supportsLocalRead()) {
+		return;
+	}
+	const auto key = Ayu::LocalRead::Key(session().userId().bare, peer->id.value);
+	const auto record = Ayu::LocalRead::Parse(
+		session().local().readPref<QByteArray>(key).toStdString());
+	_localReadTill = record.till;
+	_localReadAt = record.readAt;
+	_localUnreadMark = record.unreadMark;
+	if (_localReadTill > 0) {
+		_inboxReadBefore = _localReadTill + 1;
+	}
+}
+
+void History::saveLocalRead() {
+	const auto key = Ayu::LocalRead::Key(session().userId().bare, peer->id.value);
+	session().local().writePref<QByteArray>(key, QByteArray::fromStdString(
+		Ayu::LocalRead::Serialize({
+			.till = _localReadTill.bare,
+			.readAt = _localReadAt,
+			.unreadMark = _localUnreadMark,
+		})));
+}
+
+bool History::changeLocalUnreadMark(bool unread) {
+	if (!supportsLocalRead()) {
+		return false;
+	}
+	if (AyuSettings::ghost(&session()).sendReadMessages()) {
+		if (_localUnreadMark != -1) {
+			_localUnreadMark = -1;
+			saveLocalRead();
+		}
+		return false;
+	}
+	_localUnreadMark = unread ? 1 : 0;
+	saveLocalRead();
+	setUnreadMark(unread);
+	return true;
+}
+
+bool History::readLocally(MsgId tillId) {
+	if (!supportsLocalRead()
+		|| AyuSettings::ghost(&session()).sendReadMessages()
+		|| tillId < 0
+		|| tillId.bare > std::numeric_limits<int32>::max()) {
+		return false;
+	}
+	readClientSideMessages();
+	const auto last = lastServerMessage();
+	const auto count = (last && tillId >= last->id)
+		? std::optional<int>(0)
+		: countStillUnreadLocal(tillId);
+	cancelLocalReadCount();
+	if (tillId > _localReadTill || _localUnreadMark != 0) {
+		accumulate_max(_localReadTill, tillId);
+		_localReadAt = base::unixtime::now();
+		_localUnreadMark = 0;
+		saveLocalRead();
+	}
+	setUnreadMark(false);
+	if (tillId > 0) {
+		setInboxReadTill(tillId);
+	}
+	if (folderKnown() && count) {
+		setUnreadCount(*count, false);
+	} else {
+		owner().histories().requestDialogEntry(this);
+	}
+	updateChatListEntry();
+	return true;
+}
+
+void History::cancelLocalReadCount() {
+	++_localReadGeneration;
+	if (_localReadRequest) {
+		session().api().request(base::take(_localReadRequest)).cancel();
+	}
+}
+
+void History::refreshLocalReadCount(MsgId top, int serverCount) {
+	const auto counter = std::make_shared<Ayu::LocalRead::Counter>();
+	counter->till = inboxReadTillId().bare;
+	counter->before = top.bare + 1;
+	requestLocalReadPage(counter, _localReadGeneration, serverCount);
+}
+
+void History::requestLocalReadPage(
+		std::shared_ptr<Ayu::LocalRead::Counter> counter,
+		uint64 generation,
+		int serverCount) {
+	if (generation != _localReadGeneration || !supportsLocalRead()) {
+		return;
+	}
+	const auto before = (counter->before > std::numeric_limits<int32>::max())
+		? 0 : int32(counter->before);
+	_localReadRequest = session().api().request(MTPmessages_GetHistory(
+		peer->input(),
+		MTP_int(before),
+		MTP_int(0),
+		MTP_int(0),
+		MTP_int(100),
+		MTP_int(before),
+		MTP_int(counter->till),
+		MTP_long(0)
+	)).done(crl::guard(this, [=](const MTPmessages_Messages &result) {
+		if (generation != _localReadGeneration) {
+			return;
+		}
+		_localReadRequest = 0;
+		auto messages = std::vector<Ayu::LocalRead::Message>();
+		auto valid = true;
+		result.match([&](const MTPDmessages_messagesNotModified &) {
+			valid = false;
+		}, [&](const auto &data) {
+			for (const auto &message : data.vmessages().v) {
+				message.match([&](const MTPDmessage &data) {
+					messages.push_back({
+						.id = data.vid().v,
+						.incoming = !data.is_out()
+							|| data.is_post()
+							|| data.is_from_scheduled(),
+					});
+				}, [&](const MTPDmessageService &data) {
+					messages.push_back({
+						.id = data.vid().v,
+						.incoming = !data.is_out() || data.is_post(),
+					});
+				}, [&](const MTPDmessageEmpty &) {
+					valid = false;
+				});
+			}
+		});
+		if (!valid || !counter->add(messages)) {
+			return;
+		}
+		if (counter->complete) {
+			setUnreadCount(std::min(counter->count, serverCount), false);
+			calculateFirstUnreadMessage();
+			updateChatListEntry();
+		} else {
+			requestLocalReadPage(counter, generation, serverCount);
+		}
+	})).fail(crl::guard(this, [=] {
+		if (generation == _localReadGeneration) {
+			_localReadRequest = 0;
+		}
+	})).send();
+}
